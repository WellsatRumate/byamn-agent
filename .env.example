# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# Anthropic API key for Claude (used by scripts/research.mjs and agent reasoning)
ANTHROPIC_API_KEY=

# Apify token for LinkedIn / Twitter / Instagram scraping
APIFY_TOKEN=

# Optional: OpenAI key if you wire in any GPT-based fallbacks
OPENAI_API_KEY=
